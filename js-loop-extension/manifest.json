{
  "manifest_version": 3,
  "name": "JS Loop Runner",
  "version": "1.0.0",
  "description": "定时循环执行指定的 JS 代码，直到返回值匹配目标状态码时退出。",
  "_disclaimer": "本程序仅用于研究学习目的，不保证实际使用效果，请遵循当地法律法规。",
  "_copyright": "交流及版权联系：your-email@example.com",
  "permissions": ["storage", "activeTab", "scripting", "notifications", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JS Loop Runner"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
